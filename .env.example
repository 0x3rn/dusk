# Copy to .env.local for development, and set the same names in your hosting dashboard for production.
# Blank optional values turn that feature off. Never commit real values.

# Neon PostgreSQL (use the dev branch locally, production branch in hosting)
DATABASE_URL=

# Neon Auth (Neon Console > Project > Branch > Auth > Configuration)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=   # 32+ chars: openssl rand -base64 32

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the scheduler sends to /api/internal/scheduler/tick (32+ chars: openssl rand -hex 32)
CRON_SECRET=

# Payments (Lemon Squeezy). Leave all four blank to turn checkout off (it then answers 503).
LEMONSQUEEZY_API_KEY=         # Lemon Squeezy > Settings > API. Server-side only.
LEMONSQUEEZY_STORE_ID=        # Numeric store id, e.g. 12345
LEMONSQUEEZY_VARIANT_ID=      # Numeric id of the "Dusk Lifetime" variant (priced $50, one-time)
LEMONSQUEEZY_WEBHOOK_SECRET=  # Signing secret you typed when creating the webhook

# Email (Resend) and SMS (Twilio)
RESEND_API_KEY=
RESEND_FROM_EMAIL=         # e.g. Dusk <alerts@yourdomain.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Error reporting (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Trigger.dev (set APP_URL and CRON_SECRET inside the Trigger.dev project too)
TRIGGER_PROJECT_REF=
